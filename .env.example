# =============================================================================
# Inventaire des variables d'environnement
# -----------------------------------------------------------------------------
# Ce fichier est le seul a etre versionne. Il ne contient AUCUNE valeur reelle.
#
# Sur le serveur, deux fichiers distincts, ecrits a la main par
# install-serveur.sh puis completes, jamais generes par la CI et jamais copies
# dans une image (CLAUDE.md §11) :
#   /opt/brainhub/preprod/.env
#   /opt/brainhub/prod/.env
#
# Les ports INTERNES aux conteneurs sont figes dans les images : 8080 pour
# l'API, 3000 pour le serveur de rendu. Seuls les ports publies sur l'hote
# changent d'un environnement a l'autre.
# =============================================================================

# -----------------------------------------------------------------------------
# Images
# -----------------------------------------------------------------------------
# Prefixe des images a tirer, compte GitHub compris, en minuscules : Docker
# refuse les majuscules dans un nom de depot d'images.
#
# C'est la SEULE ligne a changer si le depot est transfere vers un autre compte
# GitHub, celui du client par exemple. Le depot lui-meme n'a rien a modifier :
# le workflow deduit le compte du depot qui l'execute.
REGISTRE_IMAGES=ghcr.io/geekguste

# -----------------------------------------------------------------------------
# Ports publies sur 127.0.0.1
# -----------------------------------------------------------------------------
#   production : 8080 et 3000
#   preprod    : 8082 et 3001
PORT_API_HOTE=8080
PORT_SSR_HOTE=3000

# -----------------------------------------------------------------------------
# Serveur de rendu
# -----------------------------------------------------------------------------
# Domaine servant aux URL canoniques. TOUJOURS le domaine de production, meme
# en preprod : la canonique de la preprod doit pointer vers la production.
SITE_CANONICAL_BASE_URL=https://braincorporationhub.com

# « true » en production seulement, et seulement une fois les contenus du
# client integres. Ailleurs, toutes les reponses partent avec
# X-Robots-Tag: noindex, nofollow et les pages portent une meta robots noindex.
SITE_INDEXABLE=false

# Noms d'hotes que le serveur accepte de servir, separes par des virgules.
# Protege contre la falsification de l'en-tete Host, et garantit que le site ne
# repond ni sur l'IP du serveur ni sur le nom d'hote de l'hebergeur.
#   production : braincorporationhub.com,www.braincorporationhub.com
#   preprod    : dev.braincorporationhub.com
SITE_ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# Chaine de connexion PostgreSQL. La base tourne sur l'HOTE, pas en conteneur :
# l'adresse est la passerelle du reseau Docker de l'environnement.
#   preprod    : 172.28.0.1, base et utilisateur brainhub_preprod
#   production : 172.29.0.1, base et utilisateur brainhub_prod
# Le mot de passe est genere et ecrit par install-postgresql.sh.
ConnectionStrings__BrainHub=Host=;Port=5432;Database=;Username=;Password=

# Origines autorisees pour CORS. Vide sur le serveur : le navigateur appelle
# /api sur le meme domaine, il n'y a pas de requete d'origine croisee.
# Cors__OriginesAutorisees__0=http://localhost:4200

# -----------------------------------------------------------------------------
# A venir, laisse vide tant que l'etape correspondante n'est pas faite
# -----------------------------------------------------------------------------
# Etapes 5 et 6, Stripe. Trois secrets de signature distincts : local via
# Stripe CLI, preprod, production. Chacun dans son environnement.
# Stripe__ClePubliable=
# Stripe__CleSecrete=
# Stripe__SecretWebhook=

# Etape 6, Mailjet. Expediteur noreply@braincorporationhub.com, domaine deja
# authentifie.
# Mailjet__CleApi=
# Mailjet__CleSecrete=

# Etape 7, compte administrateur unique de la page de suivi. Le mot de passe
# n'est stocke que sous forme de hachage, jamais en clair.
# Administration__Identifiant=
# Administration__HachageMotDePasse=
